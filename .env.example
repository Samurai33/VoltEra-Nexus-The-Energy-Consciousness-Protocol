# VoltEra Nexus Environment Variables

# OpenSea Collection URL (replace with your actual collection)
NEXT_PUBLIC_OPENSEA_COLLECTION_URL=https://opensea.io/collection/volt-era-energy-consciousness-2025

# VoltEra Dashboard URL
NEXT_PUBLIC_DASHBOARD_URL=https://voltera-dash.vercel.app

# IPFS Gateway URL (replace with your actual IPFS CID)
NEXT_PUBLIC_IMAGE_BASE=https://ipfs.io/ipfs/QmYourCID

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (for metadata)
NEXT_PUBLIC_SITE_URL=https://voltera-nexus.vercel.app

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=contact@voltera.tech
NEXT_PUBLIC_TWITTER_HANDLE=@VolteraTech